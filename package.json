{
  "name": "@hengm3467/stepfun-openclaw-plugin",
  "version": "0.1.0",
  "displayName": "StepFun OpenClaw Plugin",
  "description": "StepFun provider plugin for OpenClaw (prototype)",
  "files": [
    "index.ts",
    "provider-catalog.ts",
    "openclaw.plugin.json",
    "README.md"
  ],
  "type": "module",
  "devDependencies": {
    "openclaw": "^2026.3.24"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hengm3467/stepfun-openclaw-plugin.git"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "providers": [
      "stepfun",
      "stepfun-plan"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24"
    },
    "install": {
      "minHostVersion": ">=2026.3.24"
    }
  }
}
